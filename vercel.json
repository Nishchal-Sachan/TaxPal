{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite",
            "outputDirectory": "dist"
        },
        "backend": {
            "root": "backend",
            "entrypoint": "src/server.js"
        }
    },
    "rewrites": [
        {
            "source": "/api(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "handle": "filesystem"
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend",
                "path": "/index.html"
            }
        }
    ]
}