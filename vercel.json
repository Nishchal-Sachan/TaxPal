{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "entrypoint": "src/server.js"
        }
    },
    "rewrites": [
        {
            "source": "/api(/.*)?",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/assets/(.*)",
            "destination": {
                "service": "frontend",
                "path": "/assets/$1"
            }
        },
        {
            "source": "/(.*\\.(?:js|css|ico|png|jpg|jpeg|svg|json|woff2?|ttf|map))",
            "destination": {
                "service": "frontend",
                "path": "/$1"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend",
                "path": "/index.html"
            }
        }
    ]
}